# Copy this file to .env and replace every value before using docker compose.
# Do not commit the resulting .env file.
SA_PASSWORD=replace-with-a-long-unique-sql-sa-password
APP_DB_CONNECTION_STRING=Server=db,1433;Database=ApplyWise;User Id=applywise_app;Password=replace-with-a-long-unique-app-password;Encrypt=True;TrustServerCertificate=False
MIGRATION_DB_CONNECTION_STRING=Server=db,1433;Database=ApplyWise;User Id=applywise_migrator;Password=replace-with-a-different-long-migration-password;Encrypt=True;TrustServerCertificate=False
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@example.com
PUBLIC_ORIGIN=https://applywise.example.com
ALLOWED_HOSTS=applywise.example.com
ADMIN_EMAIL=awaisshaikhcs786@gmail.com
DATA_PROTECTION_CERTIFICATE_FILE=replace-with-an-absolute-path-to-a-pfx-file
DATA_PROTECTION_CERTIFICATE_PASSWORD=replace-with-the-pfx-password
