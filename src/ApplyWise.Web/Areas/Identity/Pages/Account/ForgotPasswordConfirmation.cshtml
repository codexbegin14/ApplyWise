@page
@{
    ViewData["Title"] = "Check your email";
    ViewData["MetaDescription"] = "Check your email for your ApplyWise password reset code.";
}

<div class="aw-auth-shell aw-auth-shell-status aw-fade-in">
    <section class="aw-auth-status-card aw-slide-up" aria-labelledby="reset-sent-title">
        <span class="aw-auth-kicker"><svg class="ui-icon"><use href="#i-mail" /></svg>Reset code requested</span>
        <span class="aw-auth-status-icon aw-auth-status-icon-success" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 6h16v12H4zM4 7l8 6 8-6" /><path d="m9 13 2 2 4-4" /></svg>
        </span>
        <h1 id="reset-sent-title">Check your email</h1>
        <p>If an ApplyWise account exists for that address, a six-digit password reset code is on its way.</p>

        <div class="aw-auth-status-callout aw-auth-status-callout-success" role="status">
            The code expires in 10 minutes and works only once. Check spam if it does not arrive.
        </div>
        <div class="aw-auth-status-actions">
            <a class="btn btn-primary" asp-page="./ForgotPassword">Request a reset code</a>
            <a class="btn btn-secondary-soft" asp-page="./Login">Back to log in</a>
        </div>
    </section>

    <aside class="aw-auth-visual" aria-label="Wiso helping with password recovery">
        <div class="aw-auth-quote">
            <span class="aw-auth-kicker">Return securely</span>
            <blockquote>A small reset can make room for a strong comeback.</blockquote>
            <p>Use only the newest code and never share it with anyone.</p>
        </div>
        <div class="aw-auth-avatar-wrap">
            <span>Check your inbox!</span>
            <img src="~/images/wiso.jpg" width="620" height="620" decoding="async" alt="Wiso helping with password recovery" />
        </div>
    </aside>
</div>
