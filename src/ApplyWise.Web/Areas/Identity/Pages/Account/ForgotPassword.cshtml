@page
@model ApplyWise.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset password";
    ViewData["MetaDescription"] = "Request a secure ApplyWise password reset code.";
}

<div class="aw-auth-shell aw-auth-shell-recovery aw-fade-in">
    <section class="aw-login-card aw-recovery-card aw-slide-up" aria-labelledby="forgot-password-title">
        <header class="aw-login-heading">
            <span class="aw-auth-kicker"><svg class="ui-icon"><use href="#i-mail" /></svg>Account recovery</span>
            <h1 id="forgot-password-title">Reset your password</h1>
            <p>Enter the email connected to your account. We will send a secure six-digit code.</p>
        </header>

        <form method="post" class="aw-login-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary aw-login-alert" role="alert"></div>

            <label class="aw-login-field" asp-for="Input.Email">
                <span>Email address</span>
                <span class="aw-login-input">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6" /></svg>
                    <input asp-for="Input.Email" autocomplete="email" placeholder="you@example.com" autofocus />
                </span>
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </label>

            <button type="submit" class="btn btn-primary btn-lg aw-login-submit">
                Send reset code <svg class="ui-icon"><use href="#i-arrow" /></svg>
            </button>

            <a class="aw-recovery-back" asp-page="./Login">
                <span aria-hidden="true">←</span> Back to log in
            </a>
        </form>

        <footer class="aw-login-footer"><span>✓</span> The code expires in 10 minutes and works only once.</footer>
    </section>

    <aside class="aw-auth-visual" aria-label="Wiso helping you recover your ApplyWise account">
        <div class="aw-auth-quote">
            <span class="aw-auth-kicker">Start again securely</span>
            <blockquote>A fresh start is one secure step away.</blockquote>
            <p>Wiso will help you get back to your applications, resumes, and next steps without losing your progress.</p>
        </div>
        <div class="aw-auth-avatar-wrap">
            <span>We've got this!</span>
            <img src="~/images/wiso.png" alt="Wiso helping with account recovery" />
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
