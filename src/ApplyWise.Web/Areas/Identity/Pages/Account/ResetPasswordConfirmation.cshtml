@page
@{
    ViewData["Title"] = "Password updated";
    ViewData["MetaDescription"] = "Your ApplyWise password has been securely updated.";
}

<div class="aw-auth-shell aw-auth-shell-status aw-fade-in">
    <section class="aw-auth-status-card aw-slide-up" aria-labelledby="reset-complete-title">
        <span class="aw-auth-kicker"><svg class="ui-icon"><use href="#i-settings" /></svg>Password updated</span>
        <span class="aw-auth-status-icon aw-auth-status-icon-success" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg>
        </span>
        <h1 id="reset-complete-title">Your new password is ready</h1>
        <p>Your password was changed securely. Use it the next time you log in to ApplyWise.</p>

        <div class="aw-auth-status-callout aw-auth-status-callout-success" role="status">
            Any previous password reset code or link can no longer be used.
        </div>
        <div class="aw-auth-status-actions">
            <a class="btn btn-primary" asp-page="./Login">Continue to login</a>
        </div>
    </section>

    <aside class="aw-auth-visual" aria-label="Wiso welcoming you back after a password reset">
        <div class="aw-auth-quote">
            <span class="aw-auth-kicker">Ready when you are</span>
            <blockquote>A secure return is still forward progress.</blockquote>
            <p>Sign in and pick up your job search exactly where you left it.</p>
        </div>
        <div class="aw-auth-avatar-wrap">
            <span>Welcome back!</span>
            <img src="~/images/wiso.png" alt="Wiso welcoming you back to ApplyWise" />
        </div>
    </aside>
</div>
