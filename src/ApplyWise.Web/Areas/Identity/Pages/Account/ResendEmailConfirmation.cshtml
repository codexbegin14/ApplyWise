@page
@model ApplyWise.Web.Areas.Identity.Pages.Account.ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Send a new verification code";
    ViewData["MetaDescription"] = "Request a new ApplyWise email verification code.";
}

<div class="aw-auth-shell aw-auth-shell-recovery aw-fade-in">
    <section class="aw-login-card aw-recovery-card aw-slide-up" aria-labelledby="resend-confirmation-title">
        <header class="aw-login-heading">
            <span class="aw-auth-kicker"><svg class="ui-icon"><use href="#i-mail" /></svg>Email verification</span>
            <h1 id="resend-confirmation-title">Send a new code</h1>
            <p>Enter the email used for your ApplyWise account. We will send a new six-digit verification code.</p>
        </header>

        <form method="post" class="aw-login-form">
            <input asp-for="Input.ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary aw-login-alert" role="alert"></div>

            <label class="aw-login-field" asp-for="Input.Email">
                <span>Email address</span>
                <span class="aw-login-input">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6" /></svg>
                    <input asp-for="Input.Email" autocomplete="email" placeholder="you@example.com" autofocus />
                </span>
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </label>

            <button type="submit" class="btn btn-primary btn-lg aw-login-submit">
                Send verification code <svg class="ui-icon"><use href="#i-arrow" /></svg>
            </button>

            <a class="aw-recovery-back" asp-page="./Login" asp-route-returnUrl="@Model.Input.ReturnUrl">
                <span aria-hidden="true">&larr;</span> Back to log in
            </a>
        </form>

        <footer class="aw-login-footer"><span>&#10003;</span> Codes expire after 10 minutes and work only once.</footer>
    </section>

    <aside class="aw-auth-visual" aria-label="Wiso helping you verify your ApplyWise account">
        <div class="aw-auth-quote">
            <span class="aw-auth-kicker">Protect your journey</span>
            <blockquote>Trust is the first step toward every opportunity.</blockquote>
            <p>A quick email check helps keep your resumes, applications, and personal details secure.</p>
        </div>
        <div class="aw-auth-avatar-wrap">
            <span>One quick step!</span>
            <img src="~/images/wiso.jpg" width="620" height="620" decoding="async" alt="Wiso helping with email verification" />
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
