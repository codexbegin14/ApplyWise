@{
    ViewData["Title"] = "Track every opportunity and apply with the right resume";
    ViewData["MetaDescription"] = "Track every job application, compare evidence against real requirements, and build parser-friendly resumes in one focused ApplyWise workspace.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<main id="main-content" class="aw-home" role="main">
    <section class="aw-home-hero" aria-labelledby="home-hero-title">
        <div class="aw-home-container aw-home-hero-grid">
            <div class="aw-home-hero-copy">
                <span class="aw-home-kicker aw-home-hero-kicker">Your opportunity tracker</span>
                <h1 id="home-hero-title">Track every opportunity. <span>Apply with the right resume.</span></h1>
                <p class="aw-home-lead">Keep every application, deadline, interview, and follow-up organized. Build a focused resume when you need one, then apply with confidence.</p>
                <div class="aw-home-hero-actions" aria-label="ApplyWise actions">
                    <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">Start tracking free</a>
                    <a class="btn btn-secondary-soft btn-lg" href="#how-it-works">See how it works</a>
                </div>
            </div>

            <figure class="aw-home-wiso-visual">
                <div class="aw-home-wiso-orbit">
                    <span class="aw-home-wiso-intro"><b>Your search, organized</b><small>Meet Wiso, your ApplyWise guide</small></span>
                    <span class="aw-home-wiso-card aw-home-wiso-card-tracking"><b>Opportunity tracked</b><small>Next action ready</small></span>
                    <img src="~/images/wiso.jpg"
                         width="620"
                         height="620"
                         decoding="async"
                         fetchpriority="high"
                         alt="Wiso, the ApplyWise career assistant, holding a resume checklist" />
                    <span class="aw-home-wiso-card aw-home-wiso-card-resume"><b>Right resume linked</b><small>Ready for this role</small></span>
                    <span class="aw-home-wiso-card aw-home-wiso-card-interview"><b>Interview ready</b><small>Preparation stays close</small></span>
                </div>
                <figcaption class="visually-hidden">Wiso helps organize applications, resumes, deadlines, and interviews inside ApplyWise.</figcaption>
            </figure>
        </div>
    </section>

    <section class="aw-home-section aw-home-services" id="features" aria-labelledby="services-title">
        <div class="aw-home-container">
            <header class="aw-home-section-heading">
                <span class="aw-home-kicker">One connected workspace</span>
                <h2 id="services-title">Everything you need to keep opportunities moving</h2>
                <p>Track every opportunity, choose the strongest resume for each job, and build a polished version when you need one.</p>
            </header>

            <div class="aw-home-service-grid">
                <article class="aw-home-service-card is-blue" id="job-tracker">
                    <div class="aw-home-service-icon"><svg class="ui-icon" aria-hidden="true"><use href="#i-briefcase" /></svg></div>
                    <span class="aw-home-card-number">01</span>
                    <h3>Track your job search</h3>
                    <p>Keep every application, deadline, interview, and submitted resume connected in one private workspace.</p>
                    <ul>
                        <li><span aria-hidden="true">&#10003;</span>Application status tracking</li>
                        <li><span aria-hidden="true">&#10003;</span>Application deadlines</li>
                        <li><span aria-hidden="true">&#10003;</span>Interview scheduling</li>
                        <li><span aria-hidden="true">&#10003;</span>Resume-used history</li>
                        <li><span aria-hidden="true">&#10003;</span>Clear next actions</li>
                    </ul>
                    <a asp-area="Identity" asp-page="/Account/Register">Start Tracking <svg class="ui-icon" aria-hidden="true"><use href="#i-arrow" /></svg></a>
                </article>

                <article class="aw-home-service-card is-green" id="resume-match">
                    <div class="aw-home-service-icon"><svg class="ui-icon" aria-hidden="true"><use href="#i-match" /></svg></div>
                    <span class="aw-home-card-number">02</span>
                    <h3>Choose the right resume</h3>
                    <p>Compare your resume with a job description, understand important gaps, and select the strongest version for each application.</p>
                    <ul>
                        <li><span aria-hidden="true">&#10003;</span>Readiness estimate with limitations</li>
                        <li><span aria-hidden="true">&#10003;</span>Job Match score</li>
                        <li><span aria-hidden="true">&#10003;</span>Matched and missing requirements</li>
                        <li><span aria-hidden="true">&#10003;</span>Actionable improvement review</li>
                        <li><span aria-hidden="true">&#10003;</span>Best-resume recommendation</li>
                    </ul>
                    <a asp-area="Identity" asp-page="/Account/Register">Improve Your Match <svg class="ui-icon" aria-hidden="true"><use href="#i-arrow" /></svg></a>
                </article>

                <article class="aw-home-service-card is-purple" id="resume-builder">
                    <div class="aw-home-service-icon"><svg class="ui-icon" aria-hidden="true"><use href="#i-edit-file" /></svg></div>
                    <span class="aw-home-card-number">03</span>
                    <h3>Make your resume</h3>
                    <p>Build a professional, parser-friendly resume with structured sections, live preview, local draft saving, and selectable-text PDF download.</p>
                    <ul>
                        <li><span aria-hidden="true">&#10003;</span>Guided resume sections</li>
                        <li><span aria-hidden="true">&#10003;</span>Live A4 preview</li>
                        <li><span aria-hidden="true">&#10003;</span>Conventional parser-friendly formatting</li>
                        <li><span aria-hidden="true">&#10003;</span>Download as PDF</li>
                        <li><span aria-hidden="true">&#10003;</span>Save multiple resume versions</li>
                    </ul>
                    <a asp-area="Identity" asp-page="/Account/Register">Build Your Resume <svg class="ui-icon" aria-hidden="true"><use href="#i-arrow" /></svg></a>
                </article>
            </div>
        </div>
    </section>

    <section class="aw-home-section aw-home-process" id="how-it-works" aria-labelledby="process-title">
        <div class="aw-home-container">
            <header class="aw-home-section-heading is-centered">
                <span class="aw-home-kicker">A clearer way to track and apply</span>
                <h2 id="process-title">From opportunity to interview, in three clear steps</h2>
            </header>
            <ol class="aw-home-process-list">
                <li>
                    <div class="aw-home-step-marker"><span>1</span><svg class="ui-icon" aria-hidden="true"><use href="#i-briefcase" /></svg></div>
                    <div><h3>Track the opportunity</h3><p>Save the role, source, deadline, and next action before it gets lost.</p></div>
                </li>
                <li>
                    <div class="aw-home-step-marker"><span>2</span><svg class="ui-icon" aria-hidden="true"><use href="#i-match" /></svg></div>
                    <div><h3>Choose or build the right resume</h3><p>Compare the job with your saved versions, then improve or create the strongest fit.</p></div>
                </li>
                <li>
                    <div class="aw-home-step-marker"><span>3</span><svg class="ui-icon" aria-hidden="true"><use href="#i-arrow" /></svg></div>
                    <div><h3>Apply and keep moving</h3><p>Record the resume you sent, update the status, and stay ahead of follow-ups and interviews.</p></div>
                </li>
            </ol>
        </div>
    </section>

</main>

<footer class="aw-home-footer">
    <div class="aw-home-container aw-home-footer-grid">
        <div class="aw-home-footer-brand"><a class="brand" asp-controller="Home" asp-action="Index"><img class="brand-mark" src="~/images/applywise-logo-v2.png" width="34" height="34" alt="" /><span>ApplyWise</span></a><p>Track every application. Choose the right version. Build smarter resumes.</p></div>
        <nav aria-label="Product links"><h2>Product</h2><a href="#job-tracker">Job Tracker</a><a href="#resume-match">Best Resume Match</a><a href="#resume-builder">Resume Builder</a></nav>
        <nav aria-label="Account links"><h2>Account</h2><a asp-area="Identity" asp-page="/Account/Register">Create Account</a><a asp-area="Identity" asp-page="/Account/Login">Sign In</a></nav>
        <nav aria-label="Legal and support links"><h2>Legal &amp; support</h2><a asp-controller="Home" asp-action="Privacy">Privacy</a><a asp-controller="Home" asp-action="Terms">Terms</a><a asp-controller="Home" asp-action="Support">Support</a></nav>
    </div>
    <div class="aw-home-container aw-home-footer-bottom"><span>&copy; @DateTime.UtcNow.Year ApplyWise. All rights reserved.</span><a href="#main-content">Back to top <span aria-hidden="true">&uarr;</span></a></div>
</footer>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
