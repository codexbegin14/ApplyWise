@model ApplyWise.Web.ViewModels.ApplicationImports.ApplicationImportIndexViewModel
@{
    ViewData["Title"] = "Application imports";
    var connection = Model.GmailConnection;
    var hasSyncError = connection?.LastErrorCode is not null;
}

<div class="page-heading aw-import-heading">
    <div>
        <h1>Application imports</h1>
        <p>Connect Gmail, review detected application emails, and add the useful ones to your tracker.</p>
    </div>
    <a class="btn btn-secondary-soft" asp-controller="JobApplications" asp-action="Index">View applications</a>
</div>

@if (TempData["ImportSuccess"] is string success)
{
    <div class="alert app-alert aw-import-alert" role="status">@success</div>
}
@if (TempData["ImportError"] is string error)
{
    <div class="alert aw-import-alert aw-import-error" role="alert">@error</div>
}

<section class="panel aw-import-connection">
    <div class="aw-import-connection-copy">
        <span class="aw-auth-kicker">Optional connection</span>
        <h2>Gmail application tracking</h2>
        <p>
            ApplyWise looks for application confirmations and sent messages with resume attachments.
            Email bodies and attachments are examined during sync but are not stored.
        </p>
    </div>

    @if (connection is null)
    {
        <div class="aw-import-connect-action">
            @if (Model.GoogleIntegrationConfigured)
            {
                <form asp-controller="GmailConnections" asp-action="Connect" method="post">
                    <button class="btn aw-google-button" type="submit">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.5-.2-2.2H12v4.2h5.4a4.6 4.6 0 0 1-2 3v2.7h3.3c1.9-1.8 2.9-4.4 2.9-7.7Z" />
                            <path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.3-2.7c-.9.6-2.1 1-3.4 1a5.9 5.9 0 0 1-5.5-4.1H3.1v2.8A10.1 10.1 0 0 0 12 22Z" />
                            <path fill="#FBBC05" d="M6.5 13.8a6 6 0 0 1 0-3.7V7.4H3.1a10 10 0 0 0 0 9.2l3.4-2.8Z" />
                            <path fill="#EA4335" d="M12 6.1c1.5 0 2.8.5 3.9 1.5l2.9-2.9A9.8 9.8 0 0 0 3.1 7.4l3.4 2.7A5.9 5.9 0 0 1 12 6.1Z" />
                        </svg>
                        Connect Gmail
                    </button>
                </form>
                <small>Google will show a separate read-only Gmail permission screen.</small>
            }
            else
            {
                <span class="aw-import-config-note">
                    A deployment administrator must configure Google OAuth before Gmail can be connected.
                </span>
            }
        </div>
    }
    else
    {
        <div class="aw-import-connected">
            <span class="aw-import-status @(hasSyncError ? "is-warning" : "is-connected")">
                @(hasSyncError ? "Needs attention" : "Connected")
            </span>
            <strong>@connection.EmailAddress</strong>
            <small>
                @if (connection.LastSuccessfulSyncAt.HasValue)
                {
                    <text>Last synced @connection.LastSuccessfulSyncAt.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt").</text>
                }
                else
                {
                    <text>Waiting for the first successful sync.</text>
                }
            </small>
            @if (hasSyncError)
            {
                <small class="aw-import-warning">Reconnect Gmail if the next manual sync does not succeed.</small>
            }
            <div class="aw-import-connection-actions">
                <form asp-action="Sync" method="post">
                    <button class="btn btn-primary" type="submit">Sync now</button>
                </form>
                <form asp-controller="GmailConnections" asp-action="Disconnect" method="post">
                    <button class="btn btn-danger-soft" type="submit">Disconnect</button>
                </form>
            </div>
        </div>
    }
</section>

<section class="panel aw-import-review-panel">
    <div class="aw-import-section-heading">
        <div>
            <span class="aw-auth-kicker">Review queue</span>
            <h2>Detected applications</h2>
            <p>Confirm extracted details before they become tracker entries.</p>
        </div>
        <span class="aw-import-count">@Model.PendingImports.Count pending</span>
    </div>

    @if (Model.PendingImports.Count == 0)
    {
        <div class="empty-state aw-import-empty">
            <svg class="ui-icon" aria-hidden="true"><use href="#i-mail" /></svg>
            <h3>No application emails waiting</h3>
            <p>New matching emails will appear here after Gmail syncs.</p>
        </div>
    }
    else
    {
        <div class="aw-import-list">
            @foreach (var item in Model.PendingImports)
            {
                <article class="aw-import-item">
                    <div class="aw-import-item-main">
                        <div class="aw-import-item-title">
                            <strong>@(string.IsNullOrWhiteSpace(item.JobTitle) ? "Job title needs review" : item.JobTitle)</strong>
                            <span>at</span>
                            <strong>@(string.IsNullOrWhiteSpace(item.CompanyName) ? "Company needs review" : item.CompanyName)</strong>
                        </div>
                        <p>@item.EmailSubject</p>
                        <div class="aw-import-meta">
                            <span>@item.Source</span>
                            <span>@item.Direction</span>
                            <span>@item.Confidence% confidence</span>
                            @if (item.AppliedDate.HasValue)
                            {
                                <span>@item.AppliedDate.Value.ToString("MMM d, yyyy")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.ResumeFileName))
                            {
                                <span>@item.ResumeFileName</span>
                            }
                        </div>
                    </div>
                    <div class="aw-import-item-actions">
                        <a class="btn btn-primary" asp-action="Review" asp-route-id="@item.Id">Review</a>
                        <form asp-action="Dismiss" asp-route-id="@item.Id" method="post">
                            <button class="btn btn-secondary-soft" type="submit">Dismiss</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>
